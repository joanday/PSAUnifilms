rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Films collection — any authenticated user can create (submit),
    // and any authenticated user can read approved films.
    // Officers can update (approve/return/edit theme).
    match /films/{filmId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;

      // Comments on a film — anyone can read; a signed-in user can post
      // a comment as themselves; only the comment's own author can edit
      // or delete it afterward.
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 1000;
        allow update, delete: if request.auth != null &&
          resource.data.userId == request.auth.uid;
      }

      // 1-5 star ratings, one document per rating user. Anyone can read
      // (for the average); a user can only ever write their own rating.
      match /ratings/{userId} {
        allow read: if true;
        allow create, update: if request.auth != null &&
          request.auth.uid == userId &&
          request.resource.data.rating is int &&
          request.resource.data.rating >= 1 &&
          request.resource.data.rating <= 5;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Users collection — any authenticated user can read their own doc,
    // Officers can read/write all user docs (for role management).
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // Watchlist subcollection under users
    match /users/{userId}/watchlist/{filmId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
